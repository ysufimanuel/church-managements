{
  "$schema": "WKC design tokens v1",
  "color": {
    "bg":            { "value": "#0F1117", "use": "Latar halaman utama" },
    "bg-deep":       { "value": "#0B0D12", "use": "Seksi selang-seling agar ritme vertikal terbaca" },
    "surface":       { "value": "#1A1D24", "use": "Kartu, panel" },
    "surface-raised":{ "value": "#1E222A", "use": "Badge tanggal, ikon, elemen di dalam kartu" },
    "line":          { "value": "#2D3748", "use": "Border dan divider" },
    "ink":           { "value": "#FFFFFF", "use": "Teks utama" },
    "ink-soft":      { "value": "#CBD5E1", "use": "Teks di atas foto" },
    "ink-muted":     { "value": "#A0AEC0", "use": "Teks sekunder, paragraf" },
    "ink-faint":     { "value": "#8794A8", "use": "Caption dan meta (kontras 6.1:1 di bg, 5.5:1 di surface)" },
    "accent":        { "value": "#00E5FF", "use": "CTA, nav aktif, bulan pada badge tanggal, indikator live" },
    "accent-ink":    { "value": "#0F1117", "use": "Teks di atas tombol aksen" },
    "success":       { "value": "#10B981", "use": "Status berhasil, alternatif aksen" }
  },
  "font": {
    "family": "Plus Jakarta Sans",
    "fallback": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"],
    "weights": [400, 500, 600, 700, 800]
  },
  "type": {
    "h1":      { "size": "clamp(36px, 5vw, 48px)", "weight": 700, "leading": 1.1,  "tracking": "-0.03em" },
    "h2":      { "size": "clamp(28px, 3vw, 32px)", "weight": 600, "leading": 1.15, "tracking": "-0.02em" },
    "h3":      { "size": "20px", "weight": 500, "leading": 1.3, "tracking": "-0.01em" },
    "body":    { "size": "16px", "weight": 400, "leading": 1.6, "tracking": "0" },
    "body-sm": { "size": "14px", "weight": 400, "leading": 1.6, "tracking": "0" },
    "caption": { "size": "12px", "weight": 400, "leading": 1.5, "tracking": "0" },
    "nav":     { "size": "13px", "weight": 600, "leading": 1.2, "tracking": "0.06em", "transform": "uppercase" }
  },
  "space": {
    "base": "4px",
    "scale": [4, 8, 12, 16, 20, 24, 32, 40, 48, 56, 64, 72, 96],
    "gutter": { "mobile": "16px", "desktop": "24px" },
    "section": { "mobile": "56px", "tablet": "72px", "desktop": "96px" },
    "container": "1200px"
  },
  "radius": { "chip": "10px", "badge": "12px", "card": "16px", "pill": "999px" },
  "breakpoint": { "sm": "560px", "md": "768px", "lg": "1024px", "xl": "1280px" },
  "motion": {
    "ease-out":    "cubic-bezier(0.23, 1, 0.32, 1)",
    "ease-in-out": "cubic-bezier(0.77, 0, 0.175, 1)",
    "ease-drawer": "cubic-bezier(0.32, 0.72, 0, 1)",
    "duration": { "press": "120ms", "hover": "150ms", "popover": "200ms", "drawer": "300ms", "media-hover": "400ms" }
  },
  "layer": { "nav": 20, "drawer": 30, "modal": 50 }
}
